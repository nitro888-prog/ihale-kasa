rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalDate(val) {
      return val is string && val.size() <= 10 && (val == '' || val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'nitro888@gmail.com';
    }

    function hasUserRecord() {
      return isVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveAdminUserRecord() {
      return hasUserRecord()
        && currentUserData().status == 'active'
        && currentUserData().role == 'admin';
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          isVerified()
          && (
            hasActiveAdminUserRecord()
            || (
              exists(/databases/$(database)/documents/admins/$(request.auth.uid))
              && !hasUserRecord()
            )
          )
        );
    }

    function isActiveMemberOf(workspaceOwnerId) {
      return isVerified() && (
        (isBootstrapAdmin() && request.auth.uid == workspaceOwnerId)
        || (
          hasUserRecord()
          && currentUserData().status == 'active'
          && currentUserData().workspaceOwnerId == workspaceOwnerId
        )
      );
    }

    function isWorkspaceAdmin(workspaceOwnerId) {
      return isBootstrapAdmin()
        || (
          isAdmin() && (
            request.auth.uid == workspaceOwnerId
            || (
              hasUserRecord()
              && currentUserData().status == 'active'
              && currentUserData().role == 'admin'
              && currentUserData().workspaceOwnerId == workspaceOwnerId
            )
          )
        );
    }

    function hasWorkspacePermission(workspaceOwnerId, permKey) {
      return isWorkspaceAdmin(workspaceOwnerId)
        || (
          isActiveMemberOf(workspaceOwnerId)
          && currentUserData().permissions[permKey] == true
        );
    }

    function hasAccountingPermission(workspaceOwnerId) {
      return isWorkspaceAdmin(workspaceOwnerId)
        || (
          isActiveMemberOf(workspaceOwnerId)
          && (
            ('canManageAccounting' in currentUserData().permissions && currentUserData().permissions.canManageAccounting == true)
            || (!('canManageAccounting' in currentUserData().permissions) && (currentUserData().permissions.canManageProducts == true || currentUserData().permissions.canManageSettings == true))
          )
        );
    }

    function hasQuotesPermission(workspaceOwnerId) {
      return isWorkspaceAdmin(workspaceOwnerId)
        || (
          isActiveMemberOf(workspaceOwnerId)
          && (
            ('canManageQuotes' in currentUserData().permissions && currentUserData().permissions.canManageQuotes == true)
            || (!('canManageQuotes' in currentUserData().permissions) && (currentUserData().permissions.canManageProducts == true || currentUserData().permissions.canManageAccounting == true))
          )
        );
    }

    function hasProjectsViewPermission(workspaceOwnerId) {
      return isWorkspaceAdmin(workspaceOwnerId)
        || (
          isActiveMemberOf(workspaceOwnerId)
          && ('canViewProjects' in currentUserData().permissions && currentUserData().permissions.canViewProjects == true)
        );
    }

    function hasPricingPermission(workspaceOwnerId) {
      return isWorkspaceAdmin(workspaceOwnerId)
        || (
          isActiveMemberOf(workspaceOwnerId)
          && ('canManagePricing' in currentUserData().permissions && currentUserData().permissions.canManagePricing == true)
        );
    }

    function canQueryProjectsScreen() {
      return isBootstrapAdmin()
        || (
          hasUserRecord()
          && currentUserData().status == 'active'
          && (
            currentUserData().role == 'admin'
            || ('canViewProjects' in currentUserData().permissions && currentUserData().permissions.canViewProjects == true)
          )
        );
    }

    function isValidPermissions(p) {
      return p is map
        && p.keys().hasAll([
          'canCreateTender', 'canEditTender', 'canDeleteTender',
          'canManageVault', 'canManageProducts', 'canAnalyzeDocuments', 'canManageSettings'
        ])
        && p.keys().hasOnly([
          'canCreateTender', 'canEditTender', 'canDeleteTender',
          'canManageVault', 'canManageProducts', 'canAnalyzeDocuments', 'canManageSettings',
          'canManageAccounting', 'canViewProjects', 'canManageQuotes', 'canManagePricing'
        ])
        && p.canCreateTender is bool
        && p.canEditTender is bool
        && p.canDeleteTender is bool
        && p.canManageVault is bool
        && p.canManageProducts is bool
        && p.canAnalyzeDocuments is bool
        && p.canManageSettings is bool
        && (!('canManageAccounting' in p) || p.canManageAccounting is bool)
        && (!('canViewProjects' in p) || p.canViewProjects is bool)
        && (!('canManageQuotes' in p) || p.canManageQuotes is bool)
        && (!('canManagePricing' in p) || p.canManagePricing is bool);
    }

    function isValidMemberIds(data) {
      return !('memberIds' in data) || (
        data.memberIds is list
        && data.memberIds.size() <= 50
        && (data.memberIds.size() == 0 || (data.memberIds[0] is string && data.memberIds[0].size() >= 1 && data.memberIds[0].size() <= 128))
      );
    }

    function isValidManagerUids(data) {
      return !('managerUids' in data) || (
        data.managerUids is list
        && data.managerUids.size() <= 20
        && (data.managerUids.size() == 0 || (data.managerUids[0] is string && data.managerUids[0].size() >= 1 && data.managerUids[0].size() <= 128))
      );
    }

    function isRecordCreator(data) {
      return ('createdBy' in data && data.createdBy is string && data.createdBy != '')
        ? data.createdBy == request.auth.uid
        : data.ownerId == request.auth.uid;
    }

    function isValidOptionalCreatorFields(data) {
      return (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 && isValidId(data.createdBy)))
        && (!('createdByEmail' in data) || (data.createdByEmail is string && data.createdByEmail.size() <= 120))
        && (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100));
    }

    function hasValidCreatorOnCreate(data) {
      return ('createdBy' in data)
        && ('createdByEmail' in data)
        && ('createdByName' in data)
        && data.createdBy == request.auth.uid
        && data.createdByEmail.lower() == request.auth.token.email.lower();
    }

    function preservesCreatorOnUpdate(inData, exData) {
      return (!('createdBy' in exData) || (('createdBy' in inData) && inData.createdBy == exData.createdBy))
        && (!('createdByEmail' in exData) || (('createdByEmail' in inData) && inData.createdByEmail == exData.createdByEmail))
        && (!('createdByName' in exData) || (('createdByName' in inData) && inData.createdByName == exData.createdByName));
    }

    // Validation Helpers
    function isValidUserAuth(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'department', 'role', 'status',
          'workspaceOwnerId', 'inviteId', 'permissions', 'approvedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'department', 'role', 'status',
          'workspaceOwnerId', 'inviteId', 'permissions', 'approvedBy',
          'managerUids', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() <= 100
        && data.department is string && data.department.size() <= 80
        && data.role is string && data.role in ['admin', 'ihale_sorumlusu', 'onay_yetkilisi', 'goruntuleyici']
        && data.status is string && data.status in ['pending', 'active', 'suspended']
        && data.workspaceOwnerId is string && data.workspaceOwnerId.size() <= 128 && (data.workspaceOwnerId == '' || isValidId(data.workspaceOwnerId))
        && data.inviteId is string && data.inviteId.size() <= 128 && (data.inviteId == '' || isValidId(data.inviteId))
        && isValidPermissions(data.permissions)
        && data.approvedBy is string && data.approvedBy.size() <= 128 && (data.approvedBy == '' || isValidId(data.approvedBy))
        && isValidManagerUids(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll([
          'email', 'displayName', 'department', 'role', 'workspaceOwnerId',
          'permissions', 'invitedBy', 'status', 'claimedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'displayName', 'department', 'role', 'workspaceOwnerId',
          'permissions', 'invitedBy', 'status', 'claimedBy', 'createdAt', 'updatedAt'
        ])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() <= 100
        && data.department is string && data.department.size() <= 80
        && data.role is string && data.role in ['admin', 'ihale_sorumlusu', 'onay_yetkilisi', 'goruntuleyici']
        && data.workspaceOwnerId is string && data.workspaceOwnerId.size() >= 1 && data.workspaceOwnerId.size() <= 128 && isValidId(data.workspaceOwnerId)
        && isValidPermissions(data.permissions)
        && data.invitedBy is string && data.invitedBy.size() >= 1 && data.invitedBy.size() <= 128 && isValidId(data.invitedBy)
        && data.status is string && data.status in ['pending_claim', 'claimed']
        && data.claimedBy is string && data.claimedBy.size() <= 128 && (data.claimedBy == '' || isValidId(data.claimedBy))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidCompanyProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'companyName', 'taxOffice', 'taxNumber',
          'authorizedPerson', 'phone', 'email', 'defaultReminderDays', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'companyName', 'taxOffice', 'taxNumber',
          'authorizedPerson', 'phone', 'email', 'defaultReminderDays', 'memberIds', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120
        && data.taxOffice is string && data.taxOffice.size() <= 80
        && data.taxNumber is string && data.taxNumber.size() <= 20
        && data.authorizedPerson is string && data.authorizedPerson.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 120
        && data.defaultReminderDays is number && data.defaultReminderDays >= 0 && data.defaultReminderDays <= 30
        && isValidMemberIds(data)
        && data.updatedAt is timestamp;
    }

    function isValidChecklist(c) {
      return c is map
        && c.keys().hasAll([
          'idariSartname', 'teknikSartname', 'teklifMektubu',
          'geciciTeminat', 'imzaSirkuleri', 'birimFiyat'
        ])
        && c.keys().hasOnly([
          'idariSartname', 'teknikSartname', 'teklifMektubu',
          'geciciTeminat', 'imzaSirkuleri', 'birimFiyat'
        ])
        && c.idariSartname is bool
        && c.teknikSartname is bool
        && c.teklifMektubu is bool
        && c.geciciTeminat is bool
        && c.imzaSirkuleri is bool
        && c.birimFiyat is bool;
    }

    function isValidTender(data) {
      return data.keys().hasAll([
          'ownerId', 'trackingCode', 'ikn', 'title', 'authority',
          'tenderDate', 'tenderTime', 'location', 'procurementType',
          'estimatedAmount', 'bidBondAmount', 'currency', 'status',
          'notes', 'checklist', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'trackingCode', 'ikn', 'title', 'authority',
          'tenderDate', 'tenderTime', 'location', 'procurementType',
          'estimatedAmount', 'bidBondAmount', 'currency', 'status',
          'notes', 'checklist', 'memberIds', 'createdBy', 'createdByEmail',
          'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.trackingCode is string && data.trackingCode.size() >= 1 && data.trackingCode.size() <= 32
        && data.ikn is string && data.ikn.size() <= 40
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.authority is string && data.authority.size() >= 1 && data.authority.size() <= 160
        && data.tenderDate is string && data.tenderDate.size() == 10 && data.tenderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.tenderTime is string && data.tenderTime.size() == 5 && data.tenderTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.location is string && data.location.size() <= 160
        && data.procurementType is string && data.procurementType.size() <= 32 && data.procurementType in ['acik_ihale', 'belli_istekliler', 'pazarlik', 'dogrudan_temin']
        && data.estimatedAmount is number && data.estimatedAmount >= 0
        && data.bidBondAmount is number && data.bidBondAmount >= 0
        && data.currency is string && data.currency.size() == 3 && data.currency in ['TRY', 'USD', 'EUR']
        && data.status is string && data.status.size() <= 32 && data.status in ['hazirlik', 'onay_bekliyor', 'teslim_edildi', 'kazanildi', 'sonuclandi', 'iptal']
        && data.notes is string && data.notes.size() <= 2000
        && isValidChecklist(data.checklist)
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTenderDoc(data, tenderId) {
      return data.keys().hasAll([
          'ownerId', 'tenderId', 'name', 'category', 'mimeType',
          'sizeBytes', 'chunkCount', 'sha256', 'verified', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'tenderId', 'name', 'category', 'mimeType',
          'sizeBytes', 'chunkCount', 'sha256', 'verified', 'notes',
          'memberIds', 'createdBy', 'createdByEmail', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.tenderId is string && data.tenderId.size() >= 1 && data.tenderId.size() <= 128 && data.tenderId == tenderId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string && data.category.size() <= 40 && data.category in [
          'idari_sartname', 'teknik_sartname', 'teklif_mektubu',
          'gecici_teminat', 'birim_fiyat', 'yetki_belgesi', 'zeyilname', 'diger'
        ]
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.sizeBytes is number && data.sizeBytes >= 1 && data.sizeBytes <= 10485760
        && data.chunkCount is number && data.chunkCount >= 1 && data.chunkCount <= 40
        && data.sha256 is string && data.sha256.size() == 64
        && data.verified is bool
        && data.notes is string && data.notes.size() <= 500
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompanyVaultDoc(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'category', 'mimeType', 'sizeBytes',
          'chunkCount', 'sha256', 'expiryDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'category', 'mimeType', 'sizeBytes',
          'chunkCount', 'sha256', 'expiryDate', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.category is string && data.category.size() <= 40 && data.category in [
          'imza_sirkuleri', 'vergi_levhasi', 'ticaret_sicil',
          'oda_kayit', 'borcu_yoktur', 'is_bitirme', 'teminat_mektubu', 'diger'
        ]
        && data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120
        && data.sizeBytes is number && data.sizeBytes >= 1 && data.sizeBytes <= 10485760
        && data.chunkCount is number && data.chunkCount >= 1 && data.chunkCount <= 40
        && data.sha256 is string && data.sha256.size() == 64
        && data.expiryDate is string && data.expiryDate.size() <= 10
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChunk(data, docId) {
      return data.keys().hasAll(['ownerId', 'docId', 'index', 'data', 'createdAt'])
        && data.keys().hasOnly([
          'ownerId', 'docId', 'index', 'data', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.docId is string && data.docId.size() >= 1 && data.docId.size() <= 128 && data.docId == docId
        && data.index is number && data.index >= 0 && data.index <= 39
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 500000
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp;
    }

    function isValidBidProduct(data) {
      return data.keys().hasAll([
          'ownerId', 'tenderId', 'tenderTrackingCode', 'stockNumber', 'partNumber',
          'materialName', 'supplierCompany', 'priceDate', 'offeredSalePrice',
          'currency', 'purchaseDate', 'quotedDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'tenderId', 'tenderTrackingCode', 'stockNumber', 'partNumber',
          'materialName', 'supplierCompany', 'priceDate', 'offeredSalePrice',
          'currency', 'purchaseDate', 'quotedDate', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.tenderId is string && data.tenderId.size() <= 128 && (data.tenderId == '' || isValidId(data.tenderId))
        && data.tenderTrackingCode is string && data.tenderTrackingCode.size() <= 32
        && data.stockNumber is string && data.stockNumber.size() <= 60
        && data.partNumber is string && data.partNumber.size() <= 60
        && data.materialName is string && data.materialName.size() >= 1 && data.materialName.size() <= 200
        && data.supplierCompany is string && data.supplierCompany.size() >= 1 && data.supplierCompany.size() <= 160
        && isValidOptionalDate(data.priceDate)
        && data.offeredSalePrice is number && data.offeredSalePrice >= 0
        && data.currency is string && data.currency.size() == 3 && data.currency in ['TRY', 'USD', 'EUR']
        && isValidOptionalDate(data.purchaseDate)
        && isValidOptionalDate(data.quotedDate)
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountingCompany(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'companyType', 'taxOffice', 'taxNumber',
          'contactPerson', 'phone', 'email', 'address', 'iban', 'notes',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'companyType', 'taxOffice', 'taxNumber',
          'contactPerson', 'phone', 'email', 'address', 'iban', 'notes',
          'memberIds', 'createdBy', 'createdByEmail', 'createdByName',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.companyType is string && data.companyType.size() <= 32 && data.companyType in ['tedarikci', 'musteri', 'her_ikisi']
        && data.taxOffice is string && data.taxOffice.size() <= 80
        && data.taxNumber is string && data.taxNumber.size() <= 20
        && data.contactPerson is string && data.contactPerson.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.email is string && data.email.size() <= 120
        && data.address is string && data.address.size() <= 240
        && data.iban is string && data.iban.size() <= 40
        && data.notes is string && data.notes.size() <= 2000
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountingEntry(data) {
      return data.keys().hasAll([
          'ownerId', 'entryType', 'companyId', 'companyName', 'invoiceNo', 'title',
          'stockNumber', 'partNumber', 'quantity', 'unit', 'unitPrice', 'vatRate',
          'subtotalAmount', 'vatAmount', 'totalAmount', 'paidAmount', 'currency',
          'entryDate', 'dueDate', 'paymentMethod', 'paymentStatus',
          'tenderId', 'tenderTrackingCode', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'entryType', 'companyId', 'companyName', 'invoiceNo', 'title',
          'stockNumber', 'partNumber', 'quantity', 'unit', 'unitPrice', 'vatRate',
          'subtotalAmount', 'vatAmount', 'totalAmount', 'paidAmount', 'currency',
          'entryDate', 'dueDate', 'paymentMethod', 'paymentStatus',
          'tenderId', 'tenderTrackingCode', 'notes', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.entryType is string && data.entryType.size() <= 32 && data.entryType in ['alis_faturasi', 'satis_faturasi', 'tahsilat', 'odeme', 'gider']
        && data.companyId is string && data.companyId.size() <= 128 && (data.companyId == '' || isValidId(data.companyId))
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && data.invoiceNo is string && data.invoiceNo.size() <= 60
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.stockNumber is string && data.stockNumber.size() <= 60
        && data.partNumber is string && data.partNumber.size() <= 60
        && data.quantity is number && data.quantity >= 0
        && data.unit is string && data.unit.size() <= 30
        && data.unitPrice is number && data.unitPrice >= 0
        && data.vatRate is number && data.vatRate >= 0 && data.vatRate <= 100
        && data.subtotalAmount is number && data.subtotalAmount >= 0
        && data.vatAmount is number && data.vatAmount >= 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.paidAmount is number && data.paidAmount >= 0
        && data.currency is string && data.currency.size() == 3 && data.currency in ['TRY', 'USD', 'EUR']
        && data.entryDate is string && data.entryDate.size() == 10 && data.entryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isValidOptionalDate(data.dueDate)
        && data.paymentMethod is string && data.paymentMethod.size() <= 32 && data.paymentMethod in ['nakit', 'banka_havale', 'kredi_karti', 'cek_senet', 'vadeli']
        && data.paymentStatus is string && data.paymentStatus.size() <= 32 && data.paymentStatus in ['bekliyor', 'odendi', 'kismi', 'iptal']
        && data.tenderId is string && data.tenderId.size() <= 128 && (data.tenderId == '' || isValidId(data.tenderId))
        && data.tenderTrackingCode is string && data.tenderTrackingCode.size() <= 32
        && data.notes is string && data.notes.size() <= 2000
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccountingCheque(data) {
      return data.keys().hasAll([
          'ownerId', 'direction', 'chequeNo', 'bankName', 'branchName', 'drawerName',
          'companyId', 'companyName', 'endorsedTo', 'issueDate', 'dueDate', 'amount',
          'currency', 'status', 'tenderId', 'tenderTrackingCode', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'direction', 'chequeNo', 'bankName', 'branchName', 'drawerName',
          'companyId', 'companyName', 'endorsedTo', 'issueDate', 'dueDate', 'amount',
          'currency', 'status', 'tenderId', 'tenderTrackingCode', 'notes', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.direction is string && data.direction.size() <= 16 && data.direction in ['alinan', 'verilen']
        && data.chequeNo is string && data.chequeNo.size() >= 1 && data.chequeNo.size() <= 60
        && data.bankName is string && data.bankName.size() >= 1 && data.bankName.size() <= 100
        && data.branchName is string && data.branchName.size() <= 100
        && data.drawerName is string && data.drawerName.size() <= 160
        && data.companyId is string && data.companyId.size() <= 128 && (data.companyId == '' || isValidId(data.companyId))
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && data.endorsedTo is string && data.endorsedTo.size() <= 160
        && isValidOptionalDate(data.issueDate)
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.amount is number && data.amount >= 0
        && data.currency is string && data.currency.size() == 3 && data.currency in ['TRY', 'USD', 'EUR']
        && data.status is string && data.status.size() <= 32 && data.status in [
          'portfoyde', 'tahsile_verildi', 'ciro_edildi', 'tahsil_edildi', 'odendi', 'karsiliksiz', 'iade'
        ]
        && data.tenderId is string && data.tenderId.size() <= 128 && (data.tenderId == '' || isValidId(data.tenderId))
        && data.tenderTrackingCode is string && data.tenderTrackingCode.size() <= 32
        && data.notes is string && data.notes.size() <= 2000
        && isValidMemberIds(data)
        && isValidOptionalCreatorFields(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectManagerUids(data) {
      return !('managerUids' in data) || (
        data.managerUids is list
        && data.managerUids.size() >= 1
        && data.managerUids.size() <= 20
        && data.managerUids[0] is string
        && data.managerUids[0].size() >= 1
        && data.managerUids[0].size() <= 128
        && isValidId(data.managerUids[0])
      );
    }

    function isValidProjectManagersList(data) {
      return !('managers' in data) || (
        data.managers is list
        && data.managers.size() >= 1
        && data.managers.size() <= 20
        && data.managers[0] is map
        && data.managers[0].keys().hasAll(['uid', 'email', 'displayName'])
        && data.managers[0].keys().hasOnly(['uid', 'email', 'displayName'])
        && data.managers[0].uid is string
        && data.managers[0].uid.size() >= 1
        && data.managers[0].uid.size() <= 128
        && isValidId(data.managers[0].uid)
        && data.managers[0].email is string
        && data.managers[0].email.size() <= 120
        && data.managers[0].displayName is string
        && data.managers[0].displayName.size() >= 1
        && data.managers[0].displayName.size() <= 100
      );
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'ownerId', 'projectCode', 'tenderId', 'tenderTrackingCode', 'title', 'authority',
          'contractAmount', 'currency', 'startDate', 'endDate', 'status',
          'managerUid', 'managerEmail', 'managerName', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'projectCode', 'tenderId', 'tenderTrackingCode', 'quoteId', 'quoteNumber',
          'title', 'authority', 'contractAmount', 'currency', 'startDate', 'endDate', 'status',
          'managerUid', 'managerEmail', 'managerName', 'managerUids', 'managers', 'notes', 'memberIds',
          'createdBy', 'createdByEmail', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && isValidId(data.ownerId)
        && data.projectCode is string && data.projectCode.size() >= 1 && data.projectCode.size() <= 32
        && data.tenderId is string && data.tenderId.size() <= 128 && (data.tenderId == '' || isValidId(data.tenderId))
        && data.tenderTrackingCode is string && data.tenderTrackingCode.size() <= 32
        && (!('quoteId' in data) || (data.quoteId is string && data.quoteId.size() <= 128 && (data.quoteId == '' || isValidId(data.quoteId))))
        && (!('quoteNumber' in data) || (data.quoteNumber is string && data.quoteNumber.size() <= 40))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.authority is string && data.authority.size() >= 1 && data.authority.size() <= 160
        && data.contractAmount is number && data.contractAmount >= 0
